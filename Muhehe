local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local CoreGui = game:GetService("CoreGui")
local Lighting = game:GetService("Lighting")
local localPlayer = Players.LocalPlayer

assert(hookmetamethod and getnamecallmethod and checkcaller and newcclosure, "Executor error")

-- Bộ lọc thông minh chặn các remote báo cáo gian lận (Anti-cheat telemetry) ngầm mà không làm nặng máy
local suspiciousKeywords = {"anticheat", "report", "detect", "ban", "integrity", "protect", "ac_", "_ac"}
local function isSuspiciousRemote(name)
    if type(name) ~= "string" then return false end
    local lower = name:lower()
    for _, keyword in ipairs(suspiciousKeywords) do
        if lower:find(keyword) then
            return true
        end
    end
    return false
end

-- 1. Chặn toàn bộ lệnh Kick, Teleport ép buộc và chặn gửi dữ liệu tố cáo bất thường về Server
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local arguments = {...}
    local isExploitCalling = false
    pcall(function() isExploitCalling = checkcaller() end)

    if not isExploitCalling then
        -- Chặn đứng lệnh Kick người chơi
        if self == localPlayer and (method == "Kick" or method == "kick") then
            return coroutine.yield()
        end

        -- Chặn các Remote tố cáo ngầm gửi về server khi bật hack
        if method == "FireServer" or method == "InvokeServer" then
            local success, name = pcall(function() return self.Name end)
            if success and isSuspiciousRemote(name) then
                return nil -- Vô hiệu hóa tín hiệu báo cáo chống gian lận
            end
        end

        -- Chặn hành vi tự hủy thư mục game cốt lõi
        if method == "ClearAllChildren" or method == "Destroy" or method == "Remove" then
            if self == localPlayer or self == localPlayer.Character or self == CoreGui or self == Lighting then
                return nil
            end
        end
    end
    return oldNamecall(self, ...)
end))

-- 2. Chặn các Index-level bypass kick ngầm
local oldIndex
oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, propertyKey)
    local isExploitCalling = false
    pcall(function() isExploitCalling = checkcaller() end)

    if not isExploitCalling then
        if self == localPlayer and (propertyKey == "Kick" or propertyKey == "kick") then
            return coroutine.yield()
        end
        if self == localPlayer and propertyKey == "GameplayPaused" then
            return false
        end
    end
    return oldIndex(self, propertyKey)
end))

