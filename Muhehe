local eternalBlacklist = {
    anticheat = true, report = true, detect = true, ban = true, 
    integrity = true, protect = true, ac = true, _ac = true, 
    kick = true, punish = true, security = true, telemetry = true, 
    payload = true, verify = true, check = true, debug = true, 
    scan = true, memory = true, exploit = true, observer = true, watch = true,
    sync = true, validation = true, state = true, analysis = true, probe = true,
    inspect = true, audit = true, tracker = true, firewall = true, corecheck = true,
    hyper = true, omega = true, sentinel = true, guard = true, shield = true,
    omni = true, absolute = true, ultimate = true, transcendent = true, void = true,
    infinite = true, eternal = true, singularity = true, apex = true, zero = true,
    zenith = true, core = true, matrix = true, boundary = true, immutable = true,
    null = true, absolute_zero = true, transcendental = true, infinity = true,
    origin = true, source = true, alpha = true, omega_prime = true, genesis = true,
    eternity = true, timeless = true, absolute_domain = true, untouchable = true
}

local function eternalVerify(name)
    if type(name) ~= "string" then return false end
    for word in name:lower():gmatch("%w+") do
        if eternalBlacklist[word] then return true end
    end
    return false
end

local eternalMock = setmetatable({}, {
    __index = function(_, k)
        if k == "Connected" or k == "Success" or k == "Valid" or k == "Status" or k == "Accepted" or k == "Clean" or k == "Safe" or k == "Verified" or k == "Absolute" or k == "Omni" or k == "Eternal" or k == "Apex" or k == "Null" or k == "Origin" or k == "Timeless" then return true end
        return function() return eternalMock end
    end,
    __call = function()
        return true, "Eternal_Singularity_Normalized"
    end,
    __tostring = function()
        return "Eternal_Core_Active"
    end
})

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local isExploitCalling = false
    pcall(function() isExploitCalling = checkcaller() end)

    if not isExploitCalling then
        if self == LocalPlayer and (method == "Kick" or method == "kick") then
            return coroutine.yield()
        end

        if method == "FireServer" or method == "InvokeServer" then
            local success, name = pcall(function() return self.Name end)
            if success and eternalVerify(name) then
                if method == "InvokeServer" then
                    return eternalMock
                end
                return nil
            end
        end

        if method == "ClearAllChildren" or method == "Destroy" or method == "Remove" then
            if self == LocalPlayer or self == LocalPlayer.Character or self == CoreGui or self == Lighting or self == Workspace then
                return nil
            end
        end
    end
    return oldNamecall(self, ...)
end))

local oldIndex
oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, propertyKey)
    local isExploitCalling = false
    pcall(function() isExploitCalling = checkcaller() end)

    if not isExploitCalling then
        if self == LocalPlayer and (propertyKey == "Kick" or propertyKey == "kick") then
            return coroutine.yield()
        end
        if self == LocalPlayer and (propertyKey == "GameplayPaused" or propertyKey == "DevComputerCameraMode") then
            return false
        end
    end
    return oldIndex(self, propertyKey)
end))

local oldNewIndex
oldNewIndex = hookmetamethod(game, "__newindex", newcclosure(function(self, propertyKey, value)
    local isExploitCalling = false
    pcall(function() isExploitCalling = checkcaller() end)

    if not isExploitCalling and self and self.Parent and self.Parent == LocalPlayer.Character then
        if propertyKey == "WalkSpeed" or propertyKey == "JumpPower" or propertyKey == "HipHeight" or propertyKey == "RotVelocity" then
            return
        end
    end
    return oldNewIndex(self, propertyKey, value)
end))

