-- Hàm kiểm tra kẻ địch linh hoạt
local function isRivalsEnemy(player)
    if player == LocalPlayer then return false end
    
    if LocalPlayer.Team and player.Team then
        return LocalPlayer.Team ~= player.Team
    end
    
    local localTeamVal = LocalPlayer:FindFirstChild("Team") or LocalPlayer:FindFirstChild("TeamValue")
    local targetTeamVal = player:FindFirstChild("Team") or player:FindFirstChild("TeamValue")
    
    if localTeamVal and targetTeamVal then
        return localTeamVal.Value ~= targetTeamVal.Value
    end

    if LocalPlayer.TeamColor and player.TeamColor then
        return LocalPlayer.TeamColor ~= player.TeamColor
    end

    return true
end

