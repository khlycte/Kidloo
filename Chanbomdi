local function getCustomImage(url, fileName)
    if writefile and getgenv and getgenv().getcustomasset then
        if not isfile(fileName) then
            local success, response = pcall(function() return game:HttpGet(url) end)
            if success then writefile(fileName, response) end
        end
        if isfile(fileName) then return getgenv().getcustomasset(fileName) end
    end
    return "rbxassetid://138379435165992"
end

