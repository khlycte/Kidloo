local dragging, dragInput, dragStart, startPos
toggleBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = toggleBtn.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

toggleBtn.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

uis.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        toggleBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- CẤP ĐỘ VÔ CỰC 10000+: Quantum Void Phase-Shifting Engine
local targetSpeed = 5000
local isSpeedEnabled = false

local function setupBypass(char)
    local root = char:WaitForChild("HumanoidRootPart", 5)
    local hum = char:WaitForChild("Humanoid", 5)
    if not root or not hum then return end

    local conn
    conn = runService.RenderStepped:Connect(function(dt)
        if isSpeedEnabled and char and char.Parent and root and hum then
            pcall(function()
                local moveDir = hum.MoveDirection
                if moveDir.Magnitude > 0 then
                    -- Vượt qua mọi ngưỡng giới hạn vật lý bằng phương pháp phân rã vector siêu tốc độ cao
                    local quantumMultiplier = targetSpeed * 0.08 * dt
                    root.CFrame = root.CFrame + (moveDir * quantumMultiplier)
                    
                    -- Khóa tuyệt đối trọng lực và triệt tiêu toàn bộ lực cản từ các block xung quanh
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end
            end)
        end
    end)

    char.AncestryChanged:Connect(function(_, p)
        if not p and conn then 
            pcall(function() conn:Disconnect() end)
        end
    end)
end

player.CharacterAdded:Connect(setupBypass)
if player.Character then setupBypass(player.Character) end

local function setSpeed()
    pcall(function()
        local val = tonumber(box.Text)
        if val and val > 0 then
            targetSpeed = val
            isSpeedEnabled = true
        end
    end)
end

